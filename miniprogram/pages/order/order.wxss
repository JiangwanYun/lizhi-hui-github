.container {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: 40rpx;
}

/* 日期栏 */
.date-section {
  background: linear-gradient(135deg, #2d6a4f 0%, #40916c 100%);
  padding: 24rpx 32rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.date-picker-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.date-picker-arrow {
  font-size: 22rpx;
  opacity: 0.7;
}
.date-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.back-today-btn {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}
.back-today-btn:active {
  background: rgba(255, 255, 255, 0.35);
}
.date-text {
  font-size: 28rpx;
  font-weight: 500;
}
.date-label {
  font-size: 26rpx;
  opacity: 0.9;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* Tab */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid #eee;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}
.tab-active {
  color: #2d6a4f;
  font-weight: 600;
}
.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #2d6a4f;
  border-radius: 2rpx;
}

/* 区块卡片 */
.section-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.badge {
  background: #c1292e;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  min-width: 36rpx;
  text-align: center;
}

/* 今日菜品列表 */
.dish-list {
  padding: 0;
}
.dish-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.dish-row:last-child {
  border-bottom: none;
}
.dish-confirmed {
  background: #f0f9f4;
  border-left: 4rpx solid #2d6a4f;
  margin: 0 -24rpx;
  padding-left: 20rpx;
  padding-right: 24rpx;
  opacity: 0.8;
}
.dish-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.dish-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}
.dish-price {
  font-size: 26rpx;
  color: #c1292e;
  font-weight: 500;
}
.dish-price-empty {
  font-size: 24rpx;
  color: #999;
}
.remove-btn {
  color: #999;
  font-size: 32rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}
.remove-btn:active {
  background: #f5f5f5;
  color: #c1292e;
}

/* 已下单标记 */
.confirmed-badge {
  font-size: 24rpx;
  color: #2d6a4f;
  background: #e8f5e9;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

/* 空状态提示 */
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
  color: #999;
  font-size: 28rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
}

/* 确认下单按钮 */
.confirm-wrap {
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
}
.confirm-info {
  flex: 1;
}
.confirm-count {
  font-size: 26rpx;
  color: #666;
  display: block;
}
.confirm-total {
  font-size: 32rpx;
  color: #c1292e;
  font-weight: 700;
  display: block;
  margin-top: 6rpx;
}
.confirm-btn {
  background: linear-gradient(135deg, #2d6a4f 0%, #40916c 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.confirm-btn:active {
  opacity: 0.85;
}
.confirm-btn[disabled] {
  background: #ccc;
  color: #fff;
}

/* 确认按钮组 */
.confirm-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.cancel-preorder-btn {
  background: transparent;
  color: #c1292e;
  border: 2rpx solid #c1292e;
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.cancel-preorder-btn:active {
  background: #fff5f5;
}

/* 菜品行操作区 */
.dish-status,
.dish-actions {
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 分割线 */
.divider {
  height: 16rpx;
  background: transparent;
}

/* 日期选择器 */
.date-picker-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.date-picker-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f8f9fa;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #e0e0e0;
}
.picker-arrow {
  font-size: 20rpx;
  color: #999;
}
.clear-btn {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 20rpx;
  background: #f0f0f0;
  border-radius: 20rpx;
}

/* 历史日志卡片 */
.history-card {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}
.history-date-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 12rpx;
}
.history-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.history-meal-tag {
  font-size: 22rpx;
  background: #e8f5e9;
  color: #2d6a4f;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}
.history-total {
  margin-left: auto;
  font-size: 28rpx;
  color: #c1292e;
  font-weight: 600;
}
.history-dishes {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.history-dish {
  background: #fff;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #555;
  border: 1rpx solid #e8e8e8;
}
.history-dish-price {
  color: #c1292e;
  font-size: 22rpx;
}
