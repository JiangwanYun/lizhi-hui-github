.page-container {
  min-height: 100vh;
  background: #f8f9fa;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  padding: 0 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.filter-item {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.filter-item.active {
  color: #2d6a4f;
  font-weight: 600;
}
.filter-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #2d6a4f;
  border-radius: 3rpx;
}

/* 搜索框 */
.search-bar {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ddd;
  border-radius: 50%;
  font-size: 22rpx;
  color: #666;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.search-clear:active {
  background: #bbb;
}

/* 分组标题 */
.section-header {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 16rpx;
  margin-top: 8rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d6a4f;
}
.section-count {
  font-size: 26rpx;
  color: #999;
  margin-left: 12rpx;
}

/* 菜品列表 */
.dish-list {
  padding: 16rpx 24rpx;
}
.dish-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 缩略图 */
.dish-thumb-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.dish-thumb {
  width: 100rpx;
  height: 100rpx;
}
.dish-thumb-placeholder {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  font-size: 44rpx;
}

/* 详情 */
.dish-detail {
  flex: 1;
  min-width: 0;
}
.dish-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}
.tag-breakfast {
  background: #fff3e0;
  color: #e65100;
}
.tag-dinner {
  background: #e8f5e9;
  color: #2d6a4f;
}
.dish-meta {
  display: flex;
  align-items: center;
}
.dish-price {
  color: #c1292e;
  font-size: 28rpx;
  font-weight: 500;
}
.dish-no-price {
  color: #bbb;
  font-size: 24rpx;
}

/* 操作按钮 */
.dish-actions {
  display: flex;
  gap: 16rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 8rpx;
  background: #f8f9fa;
}
.action-btn:active {
  background: #e0e0e0;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 220rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2d6a4f, #40916c);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  box-shadow: 0 8rpx 24rpx rgba(45,106,79,0.35);
  z-index: 100;
}
.fab:active {
  transform: scale(0.92);
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #2d6a4f, #40916c);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 48rpx;
  font-size: 30rpx;
  text-align: center;
  margin-top: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0 80rpx;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}
.init-btn {
  width: auto;
}

/* loading */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.loading-text {
  color: #999;
  font-size: 28rpx;
}
