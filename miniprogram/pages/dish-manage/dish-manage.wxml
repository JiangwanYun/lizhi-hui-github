<view class="page-container">
  <!-- 筛选Tab -->
  <view class="filter-bar">
    <view 
      wx:for="{{tabs}}" 
      wx:key="key"
      class="filter-item {{filterTab === item.key ? 'active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="switchFilter"
    >
      {{item.name}}
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索菜品（如：猪脚）" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" />
      <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">✕</view>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 分组菜品列表 -->
  <view wx:elif="{{sections.length > 0}}" class="dish-list">
    <block wx:for="{{sections}}" wx:key="key" wx:for-item="section">
      <!-- 分组标题 -->
      <view class="section-header">
        <text class="section-title">{{section.title}}</text>
        <text class="section-count">({{section.dishes.length}})</text>
      </view>
      <!-- 该分组下的菜品 -->
      <view wx:for="{{section.dishes}}" wx:for-item="dish" wx:key="_id" class="dish-item">
        <!-- 图片 -->
        <view class="dish-thumb-wrap">
          <image wx:if="{{dish.imageBase64 || dish.imageUrl || dish.imageFileId}}" class="dish-thumb" src="{{dish.imageBase64 || dish.imageUrl || dish.imageFileId}}" mode="aspectFill" />
          <view wx:else class="dish-thumb-placeholder">
            <text>{{dish.category === 'breakfast' ? '🥐' : '🍲'}}</text>
          </view>
        </view>

        <!-- 信息 -->
        <view class="dish-detail">
          <view class="dish-name-row">
            <text class="dish-name">{{dish.name}}</text>
            <text class="tag {{dish.category === 'breakfast' ? 'tag-breakfast' : 'tag-dinner'}}">
              {{dish.category === 'breakfast' ? '早餐' : '晚餐'}}
            </text>
          </view>
          <view class="dish-meta">
            <text wx:if="{{dish.price > 0}}" class="dish-price">¥{{dish.price}}</text>
            <text wx:else class="dish-no-price">未定价</text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="dish-actions">
          <view class="action-btn edit-btn" data-id="{{dish._id}}" bindtap="editDish">✏️</view>
          <view class="action-btn del-btn" data-id="{{dish._id}}" data-name="{{dish.name}}" bindtap="deleteDish">🗑️</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <text class="empty-icon">{{searchKeyword ? '🔍' : '📝'}}</text>
    <text wx:if="{{searchKeyword}}" class="empty-text">未找到「{{searchKeyword}}」相关菜品</text>
    <text wx:else class="empty-text">暂无菜品</text>
    <button wx:if="{{!searchKeyword}}" class="btn-primary init-btn" bindtap="initData">初始化默认菜品</button>
  </view>

  <!-- 浮动添加按钮 -->
  <view class="fab" bindtap="addDish">+</view>

  <!-- 底部安全区 -->
  <view style="height: 160rpx;"></view>
</view>
