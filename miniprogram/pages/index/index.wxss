.page-container {
  min-height: 100vh;
  background: #f8f9fa;
}

/* 顶部标题区 */
.header {
  background: linear-gradient(135deg, #2d6a4f 0%, #40916c 100%);
  padding: 40rpx 32rpx 32rpx;
  color: #fff;
}
.header-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.header-sub {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

/* Tab切换 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}
.tab-item.active {
  color: #2d6a4f;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #2d6a4f;
  border-radius: 3rpx;
}
.tab-emoji {
  margin-right: 8rpx;
}

/* 搜索框 */
.search-bar {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ddd;
  border-radius: 50%;
  font-size: 22rpx;
  color: #666;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.search-clear:active {
  background: #bbb;
}

/* 网格布局 */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx;
}
.grid-item {
  width: calc(50% - 24rpx);
  margin: 12rpx;
}

/* 菜品卡片 */
.dish-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}
.dish-card:active {
  transform: scale(0.97);
}
.dish-img {
  width: 100%;
  height: 240rpx;
  background: #f0f0f0;
}
.dish-img-placeholder {
  width: 100%;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
  font-size: 72rpx;
}
.dish-info {
  padding: 16rpx 20rpx 20rpx;
}
.dish-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  flex: 1;
}
/* 购物车按钮 */
.cart-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f5e9;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 8rpx;
}
.cart-btn:active {
  background: #2d6a4f;
  transform: scale(0.9);
}
.cart-btn:active .cart-icon {
  filter: brightness(0) invert(1);
}
.cart-icon {
  font-size: 28rpx;
  line-height: 1;
}
.dish-price {
  font-size: 28rpx;
  color: #c1292e;
  font-weight: 500;
}
.dish-price-empty {
  color: #bbb;
  font-size: 24rpx;
}

/* loading */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}
.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 日期选择弹窗 */
.date-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.date-modal {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}
.date-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}
.date-modal-dish {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}
.date-modal-dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d6a4f;
}
.date-modal-dish-price {
  font-size: 28rpx;
  color: #c1292e;
  font-weight: 500;
}
.date-modal-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: #f0f9f4;
  border: 2rpx solid #2d6a4f;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
}
.date-modal-picker-icon {
  font-size: 32rpx;
}
.date-modal-picker-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d6a4f;
}
.date-modal-picker-arrow {
  font-size: 24rpx;
  color: #2d6a4f;
}
.date-modal-btns {
  display: flex;
  gap: 24rpx;
}
.date-modal-cancel {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  color: #666;
  background: #f0f0f0;
  border-radius: 12rpx;
}
.date-modal-cancel:active {
  background: #e0e0e0;
}
.date-modal-confirm {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #2d6a4f 0%, #40916c 100%);
  border-radius: 12rpx;
}
.date-modal-confirm:active {
  opacity: 0.85;
}
