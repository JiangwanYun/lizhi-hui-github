.tab-bar {
  display: flex;
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
  padding: 8rpx 0;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
}
.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
}
.tab-icon {
  font-size: 40rpx;
  height: 48rpx;
  line-height: 48rpx;
}
.tab-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.tab-bar-item.active .tab-text {
  color: #2d6a4f;
  font-weight: 600;
}
