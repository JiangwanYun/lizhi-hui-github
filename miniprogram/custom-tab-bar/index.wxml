<view class="tab-bar">
  <view 
    wx:for="{{list}}" 
    wx:key="index" 
    class="tab-bar-item {{selected === index ? 'active' : ''}}" 
    data-path="{{item.pagePath}}" 
    data-index="{{index}}" 
    bindtap="switchTab"
  >
    <view class="tab-icon">{{selected === index ? item.iconActive : item.icon}}</view>
    <view class="tab-text">{{item.text}}</view>
  </view>
</view>
